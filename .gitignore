# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 12axes é "All rights reserved": o dump bruto fica só local (repo e commit em docs/pesquisa/02-extracao-simulacao.md)
/docs/pesquisa/dados/12axes/

# Configuração de deploy com o IP de origem do VPS (atrás da Cloudflare): só local, ver arvex.config.example.json
/arvex.config.json
/deploy/known_hosts
/DEPLOY.local.md

# Respostas brutas das APIs da Câmara/Senado (49 MB): regeráveis pelos scripts
/docs/pesquisa/votacoes/cache/
